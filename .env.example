POSTGRES_USER=tochka
# Сменить: python3 -c "import secrets;print(secrets.token_hex(24))"
POSTGRES_PASSWORD=please_change_me
POSTGRES_DB=tochka

# Пароль должен совпадать с POSTGRES_PASSWORD
DATABASE_URL=postgresql://tochka:please_change_me@db:5432/tochka
# Сменить: python3 -c "import secrets;print(secrets.token_urlsafe(48))" (бэкенд не стартует с дефолтом)
JWT_SECRET=change_me_in_production
JWT_TTL_HOURS=72
BACKEND_PORT=8080
CORS_ORIGIN=https://example.com

VITE_API_URL=

# Публичный домен (DNS A/AAAA должен указывать на сервер) и email для Let's Encrypt
DOMAIN=example.com
LETSENCRYPT_EMAIL=you@example.com

# Email будущего администратора (см. README про seed)
ADMIN_EMAIL=

# Grafana (мониторинг). Обязательно смените пароль перед публичным доступом.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me
